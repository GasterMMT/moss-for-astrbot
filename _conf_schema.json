{
  "connection": {
    "type": "object",
    "description": "MOSS 连接",
    "hint": "API Key 在 platform.mosi.cn 控制台创建。也可以设置环境变量 MOSS_API_KEY。",
    "items": {
      "api_key": {
        "type": "string",
        "description": "API Key",
        "hint": "留空时尝试读取环境变量 MOSS_API_KEY。",
        "default": ""
      },
      "api_base": {
        "type": "string",
        "description": "API 地址",
        "hint": "官方地址为 https://api.mosi.cn，一般不用改。",
        "default": "https://api.mosi.cn"
      },
      "proxy": {
        "type": "string",
        "description": "HTTP 代理",
        "hint": "例如 http://127.0.0.1:7890，留空不使用。",
        "default": ""
      },
      "timeout": {
        "type": "int",
        "description": "请求超时（秒）",
        "default": 120
      }
    }
  },
  "tts": {
    "type": "object",
    "description": "语音合成",
    "hint": "moss-tts-1.5-flash 更快，支持语言与 [pause 0.8s] 停顿；moss-tts-1.0-pro 更稳，不支持停顿语法。",
    "items": {
      "model": {
        "type": "string",
        "description": "TTS 模型",
        "options": [
          "moss-tts-1.5-flash",
          "moss-tts-1.0-pro",
          "moss-tts-1.5-flash-2026-06-26",
          "moss-tts-1.0-pro-2026-02-07"
        ],
        "default": "moss-tts-1.5-flash"
      },
      "voice_id": {
        "type": "string",
        "description": "音色 ID",
        "hint": "在 MOSS Create 克隆音色后复制 voice_id 粘贴到这里；插件不会内置示例音色。",
        "default": ""
      },
      "language": {
        "type": "string",
        "description": "发音语言",
        "hint": "仅 moss-tts-1.5-flash 支持，填英文全称，如 Chinese / English；留空自动判断。",
        "default": ""
      },
      "response_format": {
        "type": "string",
        "description": "输出格式",
        "options": [
          "mp3",
          "wav"
        ],
        "default": "mp3"
      },
      "max_chars": {
        "type": "int",
        "description": "单次合成字数上限",
        "default": 5000
      }
    }
  },
  "stt": {
    "type": "object",
    "description": "音频转写",
    "hint": "普通转写用 moss-transcribe-1.0；需要说话人分离时用 moss-transcribe-diarize-pro。",
    "items": {
      "model": {
        "type": "string",
        "description": "STT 模型",
        "options": [
          "moss-transcribe-1.0",
          "moss-transcribe-diarize-pro",
          "moss-transcribe-1.0-2026-07-22",
          "moss-transcribe-diarize-pro-2026-07-03"
        ],
        "default": "moss-transcribe-1.0"
      },
      "diarize": {
        "type": "bool",
        "description": "说话人分离",
        "hint": "仅在 diarize-pro 模型上生效。",
        "default": true
      },
      "keyterms": {
        "type": "list",
        "description": "关键词",
        "hint": "帮助识别专有名词，仅 diarize-pro 支持，例如 MOSS、SGLang。",
        "default": []
      },
      "include_speaker": {
        "type": "bool",
        "description": "结果带说话人",
        "hint": "在聊天与页面结果中显示 S01:。",
        "default": true
      },
      "include_timestamp": {
        "type": "bool",
        "description": "结果带时间戳",
        "hint": "每段前加 [00:01.2–00:03.4]。",
        "default": false
      },
      "max_upload_mb": {
        "type": "int",
        "description": "音频大小上限（MB）",
        "default": 100
      }
    }
  },
  "routing": {
    "type": "object",
    "description": "接入 AstrBot",
    "hint": "保存配置后自动创建 moss_tts / moss_stt 两个服务提供商；开启自动启用会把 AstrBot 的语音合成 / 识别切到 MOSS。",
    "items": {
      "auto_sync": {
        "type": "bool",
        "description": "保存后自动同步 Provider",
        "default": true
      },
      "auto_enable": {
        "type": "bool",
        "description": "同步后切换为默认语音引擎",
        "default": true
      },
      "tts_provider_id": {
        "type": "string",
        "description": "TTS Provider ID",
        "default": "moss_tts"
      },
      "stt_provider_id": {
        "type": "string",
        "description": "STT Provider ID",
        "default": "moss_stt"
      }
    }
  }
}
